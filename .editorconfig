# Repo-weite Formatierungs- und Style-Basis (QS-Review 2026-07).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = false
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning

# Interfaces beginnen mit I.
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# Private Felder mit _-Präfix, camelCase.
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

[*.{ts,js,vue,scss,css,json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf

# PublicApiAnalyzers (WP-G2, REV2 §7.3): track the public surface so any change
# shows up as a reviewable diff in PublicAPI.*.txt. Only the break-detection rules
# are kept (RS0016 missing-from-baseline, RS0017 stale-baseline-entry). The stricter
# API-design lints are out of scope for baseline tracking and fight established
# idioms, so they are disabled repo-wide:
#   RS0026 — optional-parameter overloads (CancellationToken = default is pervasive)
#   RS0027 — new public overload should not add an optional parameter
#   RS0041 — oblivious reference types (mostly EF-generated migrations)
[*.cs]
# Break detectors: explicit error so the guarantee holds even if a project ever
# turns off TreatWarningsAsErrors. RS0016 = new public symbol missing from the
# baseline; RS0017 = baseline entry whose symbol was removed or changed.
dotnet_diagnostic.RS0016.severity = error
dotnet_diagnostic.RS0017.severity = error
dotnet_diagnostic.RS0026.severity = none
dotnet_diagnostic.RS0027.severity = none
dotnet_diagnostic.RS0041.severity = none

# EF Core migrations are generated persistence plumbing, not part of the tracked
# public API — exclude them from public-surface tracking entirely.
[**/Migrations/*.cs]
dotnet_diagnostic.RS0016.severity = none
dotnet_diagnostic.RS0017.severity = none
dotnet_diagnostic.RS0037.severity = none
