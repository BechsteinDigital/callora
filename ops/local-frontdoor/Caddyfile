{
  auto_https off
}

:80 {
  handle_path /admin* {
    reverse_proxy {$ADMIN_UI_UPSTREAM:host.docker.internal:3200}
  }

  @workspace_shell_assets path /_nuxt/*
  handle @workspace_shell_assets {
    reverse_proxy {$WORKSPACE_UI_UPSTREAM:host.docker.internal:3300}
  }

  @api path /api /api/* /workspace /workspace/* /plugin-assets /plugin-assets/* /manifests /manifests/* /health /swagger /swagger/* /login
  handle @api {
    reverse_proxy {$BACKEND_UPSTREAM:callora-backend:5000}
  }

  handle {
    forward_auth {$BACKEND_UPSTREAM:callora-backend:5000} {
      uri /workspace/public/resolve
    }
    reverse_proxy {$WORKSPACE_UI_UPSTREAM:host.docker.internal:3300}
  }
}
