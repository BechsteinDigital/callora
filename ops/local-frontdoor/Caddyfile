{
  auto_https off
}

# Die lokale Frontdoor vor dem Host. Sie terminiert nichts und verteilt nichts —
# sie gibt einen stabilen Port (8080) vor einem Prozess, der auf 5000 hört.
#
# Sie sah einmal ganz anders aus, und das ist der Grund für diesen Kommentar: Sie
# leitete /admin* auf einen Admin-Shell-Dev-Server (3200), /_nuxt/* und alles
# Übrige auf eine Nuxt-Workspace-Shell (3300), und nur eine handverlesene Liste
# von Pfaden ging an das Backend. Beide Shells gibt es nicht mehr — die
# Admin-Oberfläche liegt colocated im Administration-Modul und wird vom Host unter
# /admin ausgeliefert, die öffentliche Fläche rendert Callora.Surface.Rendering.
#
# Die Konfiguration blieb trotzdem stehen. Wer die Frontdoor benutzte, bekam für
# jeden UI-Pfad einen Verbindungsfehler gegen einen Port, auf dem nichts lief, und
# jeder neue Host-Endpunkt (/surface, /ws, /mcp, /ready, /extensions) fehlte in der
# Pfadliste und fiel in denselben toten Zweig. Eine Frontdoor, die eine Liste aller
# Backend-Routen pflegen muss, ist ohnehin die falsche Bauform: Sie veraltet bei
# jedem neuen Endpunkt, und zwar still.
#
# Deshalb jetzt eine Regel statt einer Liste. Kommt eine Shell als eigener Prozess
# zurück, kommt hier ein Zweig dazu — bis dahin ist jede Sonderbehandlung eine
# Behauptung über eine Aufteilung, die es nicht gibt.

:80 {
  reverse_proxy {$BACKEND_UPSTREAM:callora-backend:5000}
}
