<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Das CalloraVoipSdk wird aus dem Schwester-Repo (BechsteinDigital/callora-voip-sdk,
         Workflow `packages`) nach nuget.org publiziert und von dort bezogen — kein lokaler Feed,
         damit die CI ohne Zugriff auf das (private) SDK-Repo restored. Wer gegen eine noch nicht
         publizierte SDK-Version entwickelt, legt lokal eine eigene, nicht eingecheckte NuGet-Quelle
         an (z.B. `dotnet nuget add source ../voip/artifacts/local-feed`), statt sie hier zu committen. -->

  </packageSources>
</configuration>
