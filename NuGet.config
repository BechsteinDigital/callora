<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Lokaler Dev-Feed für das CalloraVoipSdk: `dotnet pack` aus dem Schwester-Repo
         ../voip (CalloraVoipSdk.sln) nach ../voip/artifacts/local-feed. Der Pfad ist
         relativ zu dieser NuGet.config aufgelöst; die Repos liegen als Geschwister unter
         demselben Elternverzeichnis. Der öffentliche Feed/Publishing-Weg ist ein Follow-up. -->
    <add key="callora-voip-local" value="../voip/artifacts/local-feed" />
  </packageSources>
</configuration>
