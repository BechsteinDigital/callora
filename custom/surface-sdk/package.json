{
  "name": "@callora/surface-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed contract + blessed Vite preset for building Callora surface plugins (Vue islands/apps that dock into the surface runtime).",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite-preset": {
      "types": "./dist/vite-preset.d.ts",
      "import": "./dist/vite-preset.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "peerDependencies": {
    "vite": "^8.2.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0"
  }
}
