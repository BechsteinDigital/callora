<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Callora.Plugin.Communication.Abstractions</RootNamespace>
    <!-- Scoped to the Abstractions sources so the Communication plugin project
         (added in WP-3) can live at the same root without a glob conflict. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>Callora Communication foundation — stable cross-plugin contracts (channels, calls, capabilities) shared via the host load context. Assembly name starts with "Callora." so it is unified across plugin load contexts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Abstractions/**/*.cs" />
  </ItemGroup>

</Project>
