<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Callora.Plugin.Communication.Abstractions</RootNamespace>
    <!-- Standalone contract package, nested beside the Communication runtime
         plugin. Explicit glob keeps it self-contained (NuGet-package north-star). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>Callora Communication foundation — stable cross-plugin contracts (channels, calls, capabilities) shared via the host load context. Assembly name starts with "Callora." so it is unified across plugin load contexts.</Description>
    <!-- Baustein 1: der SDK-Contract reist als eigenes Paket in den Feed, damit
         Prod-Host UND Plugins denselben Typ aus der Default-ALC teilen (Typidentität).
         SDK-Fläche → Apache-2.0 (nicht AGPL wie die Core-Module). -->
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

</Project>
