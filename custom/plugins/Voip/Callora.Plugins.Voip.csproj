<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Host\PluginContracts\VoipHost.PluginContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CalloraVoipSdk" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="registry.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="src/Resources/app/admin/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>app/admin/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="src/Resources/app/workspace/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>app/workspace/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="src/Resources/views/workspace/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>views/workspace/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
