{% extends "base.njk" %}

{% block title %}Workspace Dashboard Alpha{% endblock %}

{% block content %}
<section class="panel" data-template-key="workspace.dashboard" data-plugin-id="template-alpha" data-version="1.0.0">
  <h1 style="margin: 0 0 8px;">Workspace Dashboard Alpha</h1>
  <p style="margin: 0; color: var(--muted);">
    This dashboard uses <code>extends</code>, <code>include</code> and block composition.
  </p>
</section>

{% if announcements and announcements.length > 0 %}
<section class="panel">
  <h2 style="margin: 0 0 8px;">Announcements</h2>
  <ul style="margin: 0; padding-left: 18px;">
    {% for item in announcements %}
      <li>{{ item }}</li>
    {% endfor %}
  </ul>
</section>
{% else %}
<section class="panel">
  <h2 style="margin: 0 0 8px;">Announcements</h2>
  <p style="margin: 0; color: var(--muted);">No announcements available.</p>
</section>
{% endif %}
{% endblock %}
