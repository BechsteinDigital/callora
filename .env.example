# Callora local development environment
# Copy to `.env` and adjust values for your workstation.

# -------------------------------------------------------------------
# Hosting runtime (maps to CalloraHosting:* in appsettings)
# -------------------------------------------------------------------
CalloraHosting__AutoBootstrapModules=true
CalloraHosting__AutoLoadPlugins=true
CalloraHosting__PluginDirectory=custom/plugins
CalloraHosting__PluginRegistryFilePath=custom/plugins/registry.json
CalloraHosting__AutoActivateInstalledPlugins=true

# -------------------------------------------------------------------
# Host backend (maps to BackendHost:* in appsettings)
# -------------------------------------------------------------------
BackendHost__DatabaseConnectionString=Host=localhost;Port=5432;Database=callora_host;Username=callora;Password=callora
BackendHost__AuditFilePath=plugins/audit-log.jsonl
BackendHost__AdminShellBaseUrl=/admin/
BackendHost__WorkspaceShellBaseUrl=/
BackendHost__PluginAssetBaseUrl=/plugin-assets
BackendHost__PluginManifestUrl=/manifests/plugin-ui-assets.manifest.json

BackendHost__RequireAllowlistForActivation=false
BackendHost__ActivationAllowlistPluginIds__0=voip
BackendHost__ActivationEntitledPluginIds__0=voip
BackendHost__DefaultActivationRolloutRing=Stable
# BackendHost__ActivationTenantRolloutRings__0__TenantId=tenant-a
# BackendHost__ActivationTenantRolloutRings__0__Ring=Beta
BackendHost__EntitlementFailureFallbackMode=DenyActivation

BackendHost__RequireApiKeyAuthentication=true
BackendHost__ApiKeyHeaderName=X-Callora-Api-Key
BackendHost__ApiKeys__0=callora-local-dev-key-change-me

# Optional legacy trust list
# BackendHost__TrustedSignerThumbprints__0=AABBCCDDEEFF00112233445566778899AABBCCDD

# Structured trusted signers example (array of objects)
# BackendHost__TrustedSigners__0__PublisherId=acme-telephony
# BackendHost__TrustedSigners__0__DisplayName=Acme Telephony GmbH
# BackendHost__TrustedSigners__0__Thumbprint=AABBCCDDEEFF00112233445566778899AABBCCDD
# BackendHost__TrustedSigners__0__Source=marketplace-sync

# Tenant-specific entitlements example (array of objects)
# BackendHost__ActivationTenantEntitlements__0__TenantId=tenant-a
# BackendHost__ActivationTenantEntitlements__0__PluginIds__0=voip

# -------------------------------------------------------------------
# Tooling / tests
# -------------------------------------------------------------------
# Used by integration persistence tests that require PostgreSQL.
# Tests create an isolated temporary database per run.
CALLORA_TEST_POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=postgres;Username=callora;Password=callora

# Optional override for local NuGet package cache
# NUGET_PACKAGES=/home/<user>/.nuget/packages

# -------------------------------------------------------------------
# Local infrastructure (docker-compose.yml)
# -------------------------------------------------------------------
DEV_CALLORA_CONTAINER_NAME=callora-backend-dev
DEV_CALLORA_PORT=5000
DEV_FRONTDOOR_CONTAINER_NAME=callora-frontdoor-dev
DEV_FRONTDOOR_PORT=8080

DEV_POSTGRES_CONTAINER_NAME=callora-postgres-dev
DEV_POSTGRES_PORT=5432
DEV_POSTGRES_DB=callora_host
DEV_POSTGRES_USER=callora
DEV_POSTGRES_PASSWORD=callora

BACKEND_UPSTREAM=callora-backend:5000

# -------------------------------------------------------------------
# Vollständige Dev-Plattform (docker-compose.dev.yml)
# -------------------------------------------------------------------
# Nur für den erweiterten Stack mit Plugins und TURN. Alle Werte haben
# Defaults; dieser Abschnitt ist Dokumentation, keine Pflicht.
#
# DEV_TURN_IP ist die Adresse, die Coturn als Relay-Kandidat ausgibt. Der
# Default ist die Docker-Bridge, weil sie beides erfüllt: aus dem
# App-Container erreichbar UND vom Browser auf diesem Rechner. 127.0.0.1
# erfüllt nur das Zweite und ergibt eine Konferenz ohne Medien. Für einen
# Test von einem zweiten Gerät die LAN-IP dieses Rechners eintragen.
# DEV_TURN_IP=172.17.0.1
# DEV_TURN_PORT=3478
# DEV_TURN_USERNAME=callora
# DEV_TURN_PASSWORD=callora-dev-turn
# DEV_TURN_REALM=callora.local

# DEV_MEDIA_IP ist die Adresse, an die der serverseitige Mediensocket bindet. Ohne sie bindet er
# an alle Interfaces, was funktioniert und Zeit kostet: der ICE-Agent sammelt dann einen
# Host-Kandidaten je Interface — hier vier Docker-Bridges plus LAN plus Loopback. Der Browser
# bringt seine eigenen mit, Chrome staffelt die Prüfungen mit ~50 ms Abstand, und aus mehreren
# Dutzend Paaren werden Sekunden bis zur Nominierung (gemessen: 2 s bis ICE, 2 s bis DTLS, bei
# 265 ms für die gesamte Signalisierung davor). Die LAN-Adresse dieses Rechners eintragen.
# DEV_MEDIA_IP=192.168.1.10

# -------------------------------------------------------------------
# Frontend shell runtime variables (Nuxt)
# -------------------------------------------------------------------
NUXT_PUBLIC_CALLORA_API_BASE=
NUXT_PUBLIC_CALLORA_PLUGIN_ASSETS_BASE=/plugin-assets
NUXT_PUBLIC_CALLORA_PLUGIN_MANIFEST_PATH=/manifests/plugin-ui-assets.manifest.json
