<Project Sdk="Microsoft.NET.Sdk">

  <!-- Roslyn analyzer enforcing the Callora extensibility contract (REV2 §7).
       Targets netstandard2.0 as required for analyzers; ships as an analyzer-only
       package (no build output assembly on consumers). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Be explicit about usings in analyzer code; the netstandard2.0 implicit set
         differs from the app projects and would only add noise here. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Analyzer assemblies are not the framework surface themselves. -->
    <CalloraFrameworkAssembly>true</CalloraFrameworkAssembly>
    <!-- RS2008: analyzer release tracking. The AnalyzerReleases.*.txt files are present
         and canonically formatted, but the .NET 10 SDK's release-tracking reader
         (Roslyn 4.14/5.0) does not recognise them in this build, so it reports RS2008
         ("no tracking file") under TreatWarningsAsErrors. Release tracking only matters
         once the analyzer ships as a versioned NuGet package (REV2 Phase 3); the files
         stay as that baseline. Suppress here until Phase-3 packaging revisits it. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.txt" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.txt" />
  </ItemGroup>

</Project>
