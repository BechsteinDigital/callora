<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Web SDK for its implicit ASP.NET usings; built as a library — the
         distribution skeleton composes it, this module has no entry point. -->
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Framework module; may consume Core's [CalloraInternal] surface. -->
    <CalloraFrameworkAssembly>true</CalloraFrameworkAssembly>
    <!-- Baustein 1: als NuGet-Paket in den lokalen Feed. -->
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Description>Callora tenant storefront surface: workspace store and template resolution served alongside the operator API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The storefront surface builds on Core's domain logic (workspace store,
         template resolution stay in Core, REV2 §4). Core never references Workspace. -->
    <ProjectReference Include="..\Core\Callora.Core.csproj" />
    <!-- REV2 §7: Callora governance analyzer (CAL0001). -->
    <ProjectReference Include="..\Analyzers\Callora.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- REV2 §7.3 (WP-G2): public-surface baseline tracking. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
