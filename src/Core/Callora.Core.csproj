<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Web SDK is kept for its implicit ASP.NET usings and wwwroot static-web-
         assets handling, but Core is now a library — Program.cs lives in the
         Callora-Production skeleton, which owns composition. -->
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Core declares and legitimately consumes the [CalloraInternal] surface. -->
    <CalloraFrameworkAssembly>true</CalloraFrameworkAssembly>
    <!-- Baustein 1: als NuGet-Paket in den lokalen Feed. -->
    <IsPackable>true</IsPackable>
    <Description>Callora platform core: framework runtime, domain logic (Identity/RBAC, tenancy), persistence and hosting composition.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- REV2 §7: run the Callora governance analyzer (CAL0001) over the framework
         assemblies too, so the boundary is validated in-tree, not only on plugins. -->
    <ProjectReference Include="..\Analyzers\Callora.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- REV2 §7.3 (WP-G2): track the public surface so any change surfaces as a
         reviewable diff in the baseline files. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The former Callora.Hosting runtime machinery now lives in Core; its
         tests still reach the internals it moved in with. -->
    <InternalsVisibleTo Include="Callora.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Explicit since the merged-in runtime machinery (formerly Callora.Hosting)
         builds against it; pins Relational to the central 10.0.9 over the lower
         version Npgsql pulls transitively. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- Plugin dependency install gate: npm-range SemVer enforcement. -->
    <PackageReference Include="Semver" />
  </ItemGroup>

</Project>
