{#
  The default layout: one column, at the readable content measure.

      {% extends "@callora/layout/page.njk" %}
      {% set page_title = "Kunden" %}
      {% block page_content %}…{% endblock %}

  page_title is a variable, not a block, because it is needed in two places — the
  document title and the heading — and a block can only be rendered once. Leave it
  unset and the page renders without a heading, which is what a landing page wants.
#}
{% extends "@callora/base.njk" %}

{% block base_title %}{{ page_title if page_title else surface.key }}{% endblock %}

{% block base_content %}
<div class="cal-page">
  {% block page_header %}
    {% if page_title %}
    <div class="cal-page__header">
      <h1 class="cal-page__title">{{ page_title }}</h1>
      {% block page_actions %}{% endblock %}
    </div>
    {% endif %}
  {% endblock %}

  <div class="cal-page__body">
    {% block page_content %}{% endblock %}
  </div>

  {% block page_footer %}{% endblock %}
</div>
{% endblock %}
