{
  "name": "@callora/surface",
  "version": "0.9.0",
  "description": "The Callora surface runtime and the contract surface plugins compile against — views, blocks, the context channel, and the blessed Vite preset.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist-lib",
    "src/styles/tokens.scss",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/public/index.d.ts",
      "import": "./dist-lib/public/index.js"
    },
    "./context": {
      "types": "./dist-lib/public/context.d.ts",
      "import": "./dist-lib/public/context.js"
    },
    "./vite-preset": {
      "types": "./dist-lib/public/vite-preset.d.ts",
      "import": "./dist-lib/vite-preset.js"
    },
    "./tokens.scss": "./src/styles/tokens.scss"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vite": "^8.2.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.11.1",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "vue": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BechsteinDigital/callora.git",
    "directory": "src/Surface.Rendering/Resources/app/surface"
  },
  "homepage": "https://github.com/BechsteinDigital/callora"
}
