<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Web SDK for its implicit ASP.NET usings; built as a library — the
         distribution skeleton composes it, this module has no entry point. -->
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Framework module; may consume Core's [CalloraInternal] surface. -->
    <CalloraFrameworkAssembly>true</CalloraFrameworkAssembly>
    <IsPackable>true</IsPackable>
    <Description>Callora surface rendering: the server-side SSR template layer (Nunjucks on a hardened Jint sandbox) that renders surface bundles to HTML (ADR-015).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The rendering layer builds on Core's surface/template resolution (REV2 §4).
         Core never references this package. -->
    <ProjectReference Include="..\Core\Callora.Core.csproj" />
    <!-- REV2 §7: Callora governance analyzer (CAL0001). -->
    <ProjectReference Include="..\Analyzers\Callora.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-015 (rev.): the base engine (A) is Nunjucks (native Twig block
         inheritance) executed on the Jint JS interpreter in a hardened sandbox.
         Both are isolated to this package. -->
    <PackageReference Include="Jint" />
    <EmbeddedResource Include="Resources\nunjucks.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host's own template bundle, addressed as @callora/… from any surface
         template. Embedded rather than published as content so it travels with the
         assembly: available before any plugin is installed, and impossible for a
         deployment to half-ship. HostSurfaceTemplates maps a path onto the resource
         name, which is why no directory here may contain a dot. -->
    <EmbeddedResource Include="Resources\views\surface\**\*.njk" />
  </ItemGroup>

  <!-- The colocated surface runtime (Resources/app/surface) is the neutral client
       grundgerüst (ADR-014 §8/§11). It builds into wwwroot/surface-app and rides
       along as a Static Web Asset, served at /surface-app; the SSR SurfaceShell
       (SpaRoot) loads /surface-app/surface.js|css. Mirrors the admin shell wiring.
       Skip with -p:SkipSurfaceFrontend=true (node not required for a .NET-only build). -->
  <PropertyGroup>
    <SurfaceFrontendDir>$(MSBuildProjectDirectory)/Resources/app/surface</SurfaceFrontendDir>
  </PropertyGroup>

  <ItemGroup>
    <SurfaceFrontendInputs Include="$(SurfaceFrontendDir)/package.json;$(SurfaceFrontendDir)/package-lock.json;$(SurfaceFrontendDir)/vite.config.ts;$(SurfaceFrontendDir)/tsconfig.json" />
    <SurfaceFrontendInputs Include="$(SurfaceFrontendDir)/src/**/*" />
  </ItemGroup>

  <Target Name="BuildSurfaceFrontend"
          Condition="'$(SkipSurfaceFrontend)' != 'true'"
          BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild"
          Inputs="@(SurfaceFrontendInputs)"
          Outputs="$(MSBuildProjectDirectory)/wwwroot/surface-app/surface.js">
    <Message Importance="high" Text="Building surface runtime frontend (npm ci + build)…" />
    <Exec Command="npm ci" WorkingDirectory="$(SurfaceFrontendDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(SurfaceFrontendDir)" />
  </Target>

  <!-- The frontend SOURCE (TS/Vite/npm, incl. node_modules) must not ride into the
       NuGet package or the static-web-asset set — only the built wwwroot/surface-app
       does. Without this the Web SDK pulls Resources/app/** in as content. -->
  <ItemGroup>
    <Content Remove="Resources/app/**" />
    <None Remove="Resources/app/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- REV2 §7.3 (WP-G2): public-surface baseline tracking. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wie in Callora.Core: Ein internes Detail darf geprüft werden, ohne dafür öffentlich
         zu werden. Die Alternative wäre, es der Vertragsfläche hinzuzufügen — für einen
         Pfadvergleich, den niemand außerhalb braucht. -->
    <InternalsVisibleTo Include="Callora.Core.Tests" />
  </ItemGroup>

</Project>
