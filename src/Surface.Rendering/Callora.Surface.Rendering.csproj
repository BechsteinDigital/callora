<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Web SDK for its implicit ASP.NET usings; built as a library — the
         distribution skeleton composes it, this module has no entry point. -->
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Framework module; may consume Core's [CalloraInternal] surface. -->
    <CalloraFrameworkAssembly>true</CalloraFrameworkAssembly>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Description>Callora surface rendering: the server-side SSR template layer (Scriban, hardened sandbox) that renders surface bundles to HTML (ADR-015).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The rendering layer builds on Core's surface/template resolution (REV2 §4).
         Core never references this package. -->
    <ProjectReference Include="..\Core\Callora.Core.csproj" />
    <!-- REV2 §7: Callora governance analyzer (CAL0001). -->
    <ProjectReference Include="..\Analyzers\Callora.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-015 (rev.): the base engine (A) is Nunjucks (native Twig block
         inheritance) executed on the Jint JS interpreter in a hardened sandbox.
         Both are isolated to this package. -->
    <PackageReference Include="Jint" />
    <EmbeddedResource Include="Resources\nunjucks.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- REV2 §7.3 (WP-G2): public-surface baseline tracking. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
