{
  "name": "@callora/admin",
  "version": "0.9.0",
  "type": "module",
  "description": "Typed contract for building Callora admin plugins: extension points, primitives, patterns.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist-lib/public/index.d.ts",
      "import": "./dist-lib/public/index.js"
    },
    "./extensions": {
      "types": "./dist-lib/public/extensions.d.ts",
      "import": "./dist-lib/public/extensions.js"
    },
    "./components": {
      "types": "./dist-lib/public/components.d.ts",
      "import": "./dist-lib/public/components.js"
    },
    "./tokens": {
      "types": "./dist-lib/public/tokens.d.ts",
      "import": "./dist-lib/public/tokens.js"
    },
    "./patterns": {
      "types": "./dist-lib/public/patterns.d.ts",
      "import": "./dist-lib/public/patterns.js"
    },
    "./vite-preset": {
      "types": "./dist-lib/public/vite-preset.d.ts",
      "import": "./dist-lib/vite-preset.js"
    },
    "./tokens.scss": "./src/core/design/tokens.scss",
    "./style.css": "./dist-lib/admin.css"
  },
  "files": [
    "dist-lib",
    "src/core/design/tokens.scss",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:catalog": "node --experimental-strip-types bin/generate-catalog.mjs src",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.11.1",
    "lucide-vue-next": "^1.0.0",
    "radix-vue": "^1.9.0",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=22.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BechsteinDigital/callora.git",
    "directory": "src/Administration/Resources/app/administration"
  },
  "homepage": "https://github.com/BechsteinDigital/callora",
  "sideEffects": false,
  "peerDependencies": {
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "radix-vue": "^1.9.0",
    "lucide-vue-next": "^1.0.0"
  }
}
