<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Web SDK for its implicit ASP.NET usings; built as a library — the
         distribution skeleton composes it, this module has no entry point. -->
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Framework module; may consume Core's [CalloraInternal] surface. -->
    <CalloraFrameworkAssembly>true</CalloraFrameworkAssembly>
    <!-- Baustein 1: als NuGet-Paket in den lokalen Feed. Die gebaute Admin-SPA
         reist als Static Web Asset mit (staticwebassets/admin/**); ein
         konsumierender Host bekommt sie automatisch unter /admin. -->
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Description>Callora operator API and colocated admin shell (Vue SPA served at /admin via static web assets).</Description>
    <!-- The admin SPA (Resources/app/administration) builds into wwwroot/admin.
         As a Web SDK project the static-web-asset base path is already the root,
         so wwwroot/admin is served at /admin — no StaticWebAssetBasePath needed
         (setting it to "admin" would double the segment to /admin/admin).
         Callora-Production inherits the assets via the project/package reference. -->
    <AdminFrontendDir>$(MSBuildProjectDirectory)/Resources/app/administration</AdminFrontendDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The operator API surface builds on Core's domain logic (Identity/RBAC,
         Tenancy stay in Core, REV2 §4). Core never references Administration. -->
    <ProjectReference Include="..\Core\Callora.Core.csproj" />
    <!-- REV2 §7: Callora governance analyzer (CAL0001). -->
    <ProjectReference Include="..\Analyzers\Callora.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- REV2 §7.3 (WP-G2): public-surface baseline tracking. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Build the admin SPA before the Web SDK collects static web assets, so the
       Vite output in wwwroot/admin is bundled. Skip with -p:SkipAdminFrontend=true
       for backend-only iteration (no Node needed). Incrementality keys on the
       frontend sources so a rebuild triggers whenever they change. -->
  <ItemGroup>
    <AdminFrontendInputs Include="$(AdminFrontendDir)/src/**/*" />
    <AdminFrontendInputs Include="$(AdminFrontendDir)/package.json;$(AdminFrontendDir)/package-lock.json;$(AdminFrontendDir)/vite.config.ts;$(AdminFrontendDir)/tsconfig.json;$(AdminFrontendDir)/index.html" />
  </ItemGroup>

  <Target Name="BuildAdminFrontend"
          BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild"
          Condition="'$(SkipAdminFrontend)' != 'true'"
          Inputs="@(AdminFrontendInputs)"
          Outputs="$(MSBuildProjectDirectory)/wwwroot/admin/index.html">
    <Message Importance="high" Text="Building admin shell frontend (npm ci + build)…" />
    <Exec Command="npm ci" WorkingDirectory="$(AdminFrontendDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(AdminFrontendDir)" />
  </Target>

  <!-- Baustein 1: die Frontend-QUELLE (TS/Vite/npm, inkl. node_modules) gehört
       NICHT ins NuGet-Paket — nur die gebaute SPA unter wwwroot/admin reist als
       Static Web Asset mit. Ohne dies zieht das Web-SDK Resources/app/administration
       als content/ ins nupkg. Betrifft nur die Paketierung, nicht Build/Run. -->
  <ItemGroup>
    <Content Remove="Resources/**" />
    <None Remove="Resources/**" />
  </ItemGroup>

</Project>
