    "RequireApiKeyAuthentication": true,
    "ApiKeyHeaderName": "X-Callora-Api-Key",
    "ApiKeys": [ "callora-local-dev-key-change-me" ],
    "RbacRoles": [],
    "RbacUserAssignments": [],
    "PlatformOperatorRoles": [ "superadmin" ],
    "ProblemTypeBaseUri": "urn:callora:problem:",
    "DemoAdminUser": {
      "Enabled": true,
      "ExternalId": "admin",
      "Email": "admin@callora.local",
      "DisplayName": "Callora Admin",
      "Password": "admin123!"
    },
    "TrustedSignerThumbprints": [],
    "AllowUnsignedPlugins": false,
    "TrustedSigners": []
