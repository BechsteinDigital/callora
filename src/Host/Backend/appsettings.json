{
  "CalloraHosting": {
    "AutoBootstrapModules": true,
    "AutoLoadPlugins": true,
    "PluginDirectory": "plugins",
    "PluginRegistryFilePath": "plugins/registry.json",
    "AutoActivateInstalledPlugins": true
  },
  "BackendHost": {
    "DatabasePath": "plugins/host.db",
    "AuditFilePath": "plugins/audit-log.jsonl",
    "RequireAllowlistForActivation": false,
    "ActivationAllowlistPluginIds": [ "voip" ],
    "RequireApiKeyAuthentication": true,
    "ApiKeyHeaderName": "X-Callora-Api-Key",
    "ApiKeys": [ "callora-local-dev-key-change-me" ]
  }
}
