{
  "CalloraHosting": {
    "AutoLoadPlugins": false,
    "PluginDirectory": "custom/plugins",
    "AutoActivateInstalledPlugins": true
  },
  "Retention": {
    "Enabled": true,
    "SweepInterval": "06:00:00",
    "CompletedJobRetention": "14.00:00:00",
    "NotificationRetention": "90.00:00:00"
  },
  "Observability": {
    "ServiceName": "callora-host",
    "OtlpEndpoint": ""
  },
  "BackendHost": {
    "EnableTenantManagementApi": false,
    "DefaultTenantKey": "default",
