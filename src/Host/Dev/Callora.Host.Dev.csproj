<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Callora.Host.Dev</RootNamespace>
    <AssemblyName>Callora.Host.Dev</AssemblyName>
    <!-- Never packed: this is the repository's own runnable composition, not a
         product. Distributions compose the packages themselves (callora-production). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project references, not packages, on purpose: a change to a module has to
         show up here on the next F5 without a pack-and-restore round trip. That is
         the whole reason this host exists next to the distribution one. -->
    <ProjectReference Include="../../Core/Callora.Core.csproj" />
    <ProjectReference Include="../../Administration/Callora.Administration.csproj" />
    <ProjectReference Include="../../Workspace/Callora.Workspace.csproj" />
    <ProjectReference Include="../../Surface.Rendering/Callora.Surface.Rendering.csproj" />
    <!-- Kein NAMENTLICHER Plugin-Vertrag. Hier stand die Referenz auf
         Callora.Plugin.Communication.Abstractions, damit Host und Plugin-ALCs
         ICommunicationChannelRegistry als EINEN Typ teilen. Seit die Plugins in
         eigenen Repositories leben (ADR-020), gibt es hier nichts fest zu
         referenzieren — und es wäre auch die falsche Stelle: WELCHE Vertrags-
         pakete eine Distribution vorlädt, entscheidet die Distribution, nicht
         das Framework. callora-production trägt die Referenz für Produktions-
         Distributionen (REV2 §10.1A). -->
  </ItemGroup>

  <ItemGroup>
    <!-- Der lokale Entwicklungsfall, den ADR-020 offen ließ: ein Plugin liegt mit
         vollem Quelltext in einem Discovery-Ordner und soll gebaut, geladen und
         benutzt werden — ohne Umweg über Paket, Publish oder Kopie.

         Das scheitert sonst an der Vertragsgrenze: PluginAssemblyLoadContext
         delegiert JEDE Assembly, die "Callora" heißt oder mit "Callora."
         beginnt, an den Default-Kontext, damit Host und Plugin dieselben
         Vertragstypen benutzen. Stellt der Host sie nicht, stirbt das Plugin
         beim Laden — als nackte TargetInvocationException ohne innere Ursache.
         Und über die Shared-Registry geht es bewusst nicht: die weist
         plugin-mitgebrachte Callora.*-Verträge ab (SharedContractAssemblyRegistry),
         weil ein Plugin sonst einen reservierten Namen besetzen könnte.

         Deshalb ein Glob und keine Liste. Dieser Host entscheidet nicht, WELCHE
         Verträge vorgeladen werden — er spiegelt, was der Entwickler lokal
         installiert hat. In CI, im Container-Build und in jeder ausgelieferten
         Distribution sind die Discovery-Ordner leer, die ItemGroup ist dann
         leer, und nichts ändert sich. Ein neu dazugeklontes Plugin bringt seinen
         Vertrag mit, ohne dass hier eine Zeile fällig wird.

         Das Muster trifft genau die Menge, die der Ladekontext an den Host
         delegiert: Callora.*-Verträge. Ein Plugin, das seinen Vertrag außerhalb
         dieses Präfixes benennt (wie VideoConference.Contracts), teilt ihn über
         die Shared-Registry und braucht hier nichts.

         Abschaltbar für den Fall, dass jemand die Vertragsgrenze bewusst OHNE
         Host-Referenz prüfen will:
           dotnet run -p:CalloraDevLoadLocalPluginContracts=false -->
    <ProjectReference
        Condition="'$(CalloraDevLoadLocalPluginContracts)' != 'false'"
        Include="$(MSBuildThisFileDirectory)../../../custom/*/*/src/**/Callora.*.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- `dotnet ef` sucht das Design-Paket im STARTPROJEKT, nicht im Migrations-Projekt.
         Ohne diese Zeile bricht jeder Tooling-Aufruf mit „doesn't reference
         Microsoft.EntityFrameworkCore.Design" ab — und Migrationen entstehen von Hand,
         inklusive Designer-Datei und Snapshot. Das ging schon mehrfach schief.

         Nur hier, nie im Distributions-Host: Das Paket zieht das Tooling-Gerüst mit,
         und `IsPackable=false` hält es aus jedem Paket heraus. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>

</Project>
