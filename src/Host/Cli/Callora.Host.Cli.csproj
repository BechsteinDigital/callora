<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>callora</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Framework CLI; may consume Core's [CalloraInternal] surface. -->
    <CalloraFrameworkAssembly>true</CalloraFrameworkAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Callora.Core.csproj" />
    <!-- REV2 §7: Callora governance analyzer (CAL0001). -->
    <ProjectReference Include="..\..\Analyzers\Callora.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The domain-neutral Core carries NO plugin reference. The distribution
         brings the Communication foundation CONTRACT (not its implementation) into
         the host default load context, so plugin ALCs — which defer all Callora.*
         to the default context — share one ICommunicationChannelRegistry type
         identity (REV2 §10.1A). callora-production carries the equivalent reference
         for production distributions. -->
    <ProjectReference Include="..\..\..\custom\static-plugins\Communication\src\Abstractions\Callora.Plugin.Communication.Abstractions.csproj" />
  </ItemGroup>

</Project>
