build/
# Ausnahme: die MSBuild-Regeln, die Callora.Plugin.Sdk seinen Konsumenten
# mitgibt, LIEGEN in build/ — die csproj packt sie explizit
# (build/Callora.Plugin.Sdk.props|.targets). Von `build/` verschluckt fehlen sie
# im Klon, `dotnet pack` bricht für dieses eine Projekt ab, und jedes Plugin baut
# danach nur noch, solange das Paket zufällig im NuGet-Cache liegt.
!src/Plugin.Sdk/build/
artifacts/
publish/
apps/*/node_modules/
apps/*/.output/
apps/*/dist/
apps/*/.nuxt/

